{% extends '_layouts/cp' %}

{% set title = 'Undeclared services'|t('jack') %}
{% set selectedSubnavItem = 'inventory' %}
{% set crumbs = [{ label: 'Inventory'|t('jack'), url: url('jack/inventory') }] %}

{% set undeclared = detections|filter(d => not d.declared) %}

{% block content %}
    <div class="readable">
        <p>{{ 'Jack read your templates, your installed plugins and your environment. Everything below is on the site; the ones flagged are not in your privacy policy.'|t('jack') }}</p>
        <p class="light smalltext">{{ 'The usual cause is not dishonesty. It is that somebody embedded a video in March and the policy was written in January.'|t('jack') }}</p>
    </div>

    {% if undeclared|length and canManage %}
        <form method="post" accept-charset="UTF-8">
            {{ csrfInput() }}
            {{ actionInput('jack/inventory/adopt') }}

            <div class="pane">
                <h2>{{ '{n, plural, =1{1 service is not declared} other{# services are not declared}}'|t('jack', { n: undeclared|length }) }}</h2>

                {% for detection in undeclared %}
                    <div style="padding: 10px 0; border-bottom: 1px solid #e4e7eb;">
                        <label>
                            <input type="checkbox" name="serviceKeys[]" value="{{ detection.serviceKey }}" checked class="checkbox">
                            <strong>{{ detection.label }}</strong>
                            <span class="light smalltext">{{ detection.category }}</span>
                        </label>
                        <ul class="light smalltext" style="margin: 6px 0 0 24px;">
                            {% for item in detection.evidence|slice(0, 5) %}
                                <li>
                                    <code>{{ item.location }}{% if item.line %}:{{ item.line }}{% endif %}</code>
                                    {% if item.excerpt %}<span style="opacity:.75;"> — {{ item.excerpt|slice(0, 90) }}</span>{% endif %}
                                </li>
                            {% endfor %}
                            {% if detection.evidence|length > 5 %}
                                <li>{{ '… and {n} more'|t('jack', { n: detection.evidence|length - 5 }) }}</li>
                            {% endif %}
                        </ul>
                    </div>
                {% endfor %}

                <div class="buttons">
                    <button type="submit" class="btn submit">{{ 'Add the ticked services'|t('jack') }}</button>
                </div>
            </div>
        </form>
    {% elseif undeclared|length == 0 %}
        <div class="pane">
            <p>{{ 'Everything Jack can see on this site is already in the inventory.'|t('jack') }}</p>
            <p class="light smalltext">{{ 'Detection reads files. A service loaded by a tag manager, or injected by a third-party script at runtime, will not appear here — Jack can only find what is written down somewhere.'|t('jack') }}</p>
        </div>
    {% endif %}

    {% set declared = detections|filter(d => d.declared) %}
    {% if declared|length %}
        <div class="pane" style="margin-top: 14px;">
            <h2>{{ 'Found and already declared'|t('jack') }}</h2>
            <ul>
                {% for detection in declared %}
                    <li>{{ detection.label }} <span class="light smalltext">— {{ '{n, plural, =1{1 place} other{# places}}'|t('jack', { n: detection.evidenceCount() }) }}</span></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}
