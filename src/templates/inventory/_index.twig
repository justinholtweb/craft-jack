{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'Inventory'|t('jack') %}
{% set selectedSubnavItem = 'inventory' %}

{% block actionButton %}
    {% if canDetect %}
        <a href="{{ url('jack/inventory/detect') }}" class="btn">{{ 'Find undeclared services'|t('jack') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="readable">
        <p>{{ 'Everyone this site hands data to. This list is the privacy policy — add Stripe here and the Stripe paragraph appears in every language you publish in, with the right legal basis and the right transfer wording.'|t('jack') }}</p>
    </div>

    {% set grouped = {} %}
    {% for entry in entries %}
        {% set grouped = grouped|merge({ (entry.category()): (grouped[entry.category()] ?? [])|merge([entry]) }) %}
    {% endfor %}

    {% for category, label in categories %}
        {% if grouped[category] is defined %}
            <div class="pane jack-group">
                <h2 id="jack-category-{{ category }}">{{ label }}</h2>
                <table class="data fullwidth" aria-labelledby="jack-category-{{ category }}">
                    <thead>
                        <tr>
                            <th scope="col">{{ 'Service'|t('jack') }}</th>
                            <th scope="col" class="thin">{{ 'Legal basis'|t('jack') }}</th>
                            <th scope="col" class="thin">{{ 'Transfer'|t('jack') }}</th>
                            {% if canManage %}
                                <th scope="col" class="thin"><span class="visually-hidden">{{ 'Actions'|t('app') }}</span></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in grouped[category] %}
                            <tr id="jack-service-{{ entry.serviceKey }}">
                                <th scope="row">
                                    <a class="jack-service-link" href="{{ url('jack/inventory/' ~ entry.serviceKey) }}">{{ entry.label() }}</a>
                                    {% if entry.custom %}<span class="light smalltext">({{ 'custom'|t('jack') }})</span>{% endif %}
                                    {% if entry.isAlwaysOn() %}<span class="light smalltext">({{ 'always on'|t('jack') }})</span>{% endif %}
                                    {% if entry.get('provider') %}<div class="light smalltext">{{ entry.get('provider') }}</div>{% endif %}
                                </th>
                                <td class="thin light smalltext">
                                    {% if entry.legalBasis() == 'consent' %}{{ 'Consent'|t('jack') }}
                                    {% elseif entry.legalBasis() == 'contract' %}{{ 'Contract'|t('jack') }}
                                    {% elseif entry.legalBasis() == 'obligation' %}{{ 'Legal obligation'|t('jack') }}
                                    {% else %}{{ 'Legitimate interest'|t('jack') }}{% endif %}
                                </td>
                                <td class="thin light smalltext">
                                    {% if entry.transfer() != 'none' %}{{ entry.transfer()|upper }}{% else %}EEA{% endif %}
                                </td>
                                {% if canManage %}
                                    <td class="thin">
                                        {% if not entry.isAlwaysOn() %}
                                            {{ disclosureMenu([
                                                { label: 'Edit'|t('app'), url: url('jack/inventory/' ~ entry.serviceKey) },
                                                {
                                                    label: 'Remove'|t('app'),
                                                    destructive: true,
                                                    attributes: {
                                                        class: ['jack-remove'],
                                                        data: { key: entry.serviceKey, label: entry.label() },
                                                    },
                                                },
                                            ], {
                                                hiddenLabel: 'Actions for {service}'|t('jack', { service: entry.label() }),
                                                buttonAttributes: { class: ['action-btn'] },
                                            }) }}
                                        {% endif %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endfor %}

    {% if canManage %}
        <div class="pane jack-group">
            <h2>{{ 'Add a service'|t('jack') }}</h2>
            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('jack/inventory/add') }}

                {% set options = [{ label: '—', value: '' }] %}
                {% for category, services in available %}
                    {% for key, label in services %}
                        {% set options = options|merge([{ label: (categories[category] ?? category) ~ ' — ' ~ label, value: key }]) %}
                    {% endfor %}
                {% endfor %}

                {{ forms.selectField({
                    label: 'From the library'|t('jack'),
                    instructions: 'Provider, address, legal basis and transfer wording all come with it.'|t('jack'),
                    name: 'serviceKey',
                    options: options,
                }) }}

                <div class="buttons">
                    <button type="submit" class="btn submit">{{ 'Add'|t('jack') }}</button>
                </div>
            </form>

            <hr>

            <form method="post" accept-charset="UTF-8">
                {{ csrfInput() }}
                {{ actionInput('jack/inventory/add') }}
                {{ forms.textField({
                    label: 'Something else'|t('jack'),
                    instructions: 'A key for a service the library has never heard of — lowercase letters, numbers and underscores. You describe it on the next screen.'|t('jack'),
                    name: 'serviceKey',
                    placeholder: 'our_crm',
                }) }}
                <div class="buttons">
                    <button type="submit" class="btn">{{ 'Add a custom service'|t('jack') }}</button>
                </div>
            </form>
        </div>
    {% endif %}

    {% if disabled|length %}
        <div class="pane jack-group">
            <h2>{{ 'Switched off'|t('jack') }}</h2>
            <p class="light smalltext">{{ 'Kept, but left out of every document.'|t('jack') }}</p>
            <ul>
                {% for entry in disabled %}
                    <li><a href="{{ url('jack/inventory/' ~ entry.serviceKey) }}">{{ entry.label() }}</a></li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}

{% do view.registerTranslations('jack', [
    'Remove {service} from the inventory?',
    'Couldn’t remove that entry.',
    'Service removed.',
]) %}

{% css %}
.jack-group { margin-block-end: var(--m); }
.jack-service-link { font-weight: 600; }
{% endcss %}

{% js %}
// Posted with sendActionRequest rather than a formsubmit link: this screen already carries two
// forms of its own, and a third wrapped around the table would nest them.
document.addEventListener('click', function(event) {
    var button = event.target.closest('.jack-remove');
    if (!button || button.disabled) {
        return;
    }

    if (!confirm(Craft.t('jack', 'Remove {service} from the inventory?', { service: button.dataset.label }))) {
        return;
    }

    button.disabled = true;

    Craft.sendActionRequest('POST', 'jack/inventory/remove', {
        data: { serviceKey: button.dataset.key },
    }).then(function(response) {
        Craft.cp.displaySuccess(response?.data?.message || Craft.t('jack', 'Service removed.'));
        var row = document.getElementById('jack-service-' + button.dataset.key);
        var tbody = row ? row.parentNode : null;
        if (row) {
            row.remove();
        }
        // An emptied category would leave a heading over nothing, so let the server redraw it.
        if (tbody && !tbody.children.length) {
            window.location.reload();
        }
    }).catch(function(error) {
        button.disabled = false;
        Craft.cp.displayError(error?.response?.data?.message || Craft.t('jack', 'Couldn’t remove that entry.'));
    });
});
{% endjs %}
