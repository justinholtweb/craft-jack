{% extends '_layouts/cp' %}

{% set title = 'Audit'|t('jack') %}
{% set selectedSubnavItem = 'audit' %}

{% block content %}
    <div class="readable">
        <p>{{ 'Everything wrong with this site’s legal texts, worst first. The expensive failures are absences, and absences never appear on a screen that lists what you have.'|t('jack') }}</p>
    </div>

    <div class="pane" style="margin-bottom: 14px;">
        <div class="flex" style="gap: 2rem;">
            <div>
                <div style="font-size: 2rem; font-weight: 600; color: {{ counts.critical ? '#cf1124' : '#27ab83' }};">{{ counts.critical }}</div>
                <div class="light smalltext">{{ 'critical'|t('jack') }}</div>
            </div>
            <div>
                <div style="font-size: 2rem; font-weight: 600; color: {{ counts.warning ? '#f0b429' : '#8c95a3' }};">{{ counts.warning }}</div>
                <div class="light smalltext">{{ 'to fix'|t('jack') }}</div>
            </div>
            <div>
                <div style="font-size: 2rem; font-weight: 600; color: #8c95a3;">{{ counts.notice }}</div>
                <div class="light smalltext">{{ 'worth knowing'|t('jack') }}</div>
            </div>
        </div>
    </div>

    {% for finding in findings %}
        {% set colour = finding.severity == 'critical' ? '#cf1124' : (finding.severity == 'warning' ? '#f0b429' : '#8c95a3') %}
        <div class="pane" style="margin-bottom: 10px; border-left: 3px solid {{ colour }};">
            <h3 style="margin: 0 0 4px;">{{ finding.title }}</h3>
            <p style="margin: 0 0 8px;">{{ finding.detail }}</p>
            <p style="margin: 0;"><strong>{{ 'Fix:'|t('jack') }}</strong> {{ finding.remedy }}</p>
            {% if finding.citation %}
                <p class="light smalltext" style="margin: 6px 0 0;">{{ finding.citation }}</p>
            {% endif %}
        </div>
    {% else %}
        <div class="pane">
            <p>{{ 'Nothing to report. Every document exists, compiles cleanly and is current with the library.'|t('jack') }}</p>
        </div>
    {% endfor %}

    <div class="readable" style="margin-top: 2rem;">
        <p class="light smalltext">
            {{ 'Clause library reviewed {date}.'|t('jack', { date: libraryVersion }) }}
            {% if not isPro %} {{ 'Jack Lite does not scan the site for undeclared services — that is where most surprises are.'|t('jack') }}{% endif %}
        </p>
    </div>
{% endblock %}
