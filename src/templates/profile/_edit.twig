{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = site ? 'Profile'|t('jack') ~ ' — ' ~ site.name : 'Profile'|t('jack') %}
{% set selectedSubnavItem = 'profile' %}
{% set fullPageForm = canEdit %}

{% block actionButton %}
    {% if canEdit %}
        <button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>
    {% endif %}
{% endblock %}

{% block sidebar %}
    {% if multiSite %}
        {% set navItems = { global: { label: 'Global'|t('jack'), url: 'jack/profile' } } %}
        {% for s in sites %}
            {% set navItems = navItems|merge({ (s.handle): { label: s.name|t('site'), url: 'jack/profile/' ~ s.handle } }) %}
        {% endfor %}
        <h2 class="h6 jack-sidebar-heading">{{ 'Per-site overrides'|t('jack') }}</h2>
        {% include '_includes/nav' with {
            label: 'Per-site overrides'|t('jack'),
            items: navItems,
            selectedItem: site ? site.handle : 'global',
        } only %}
    {% endif %}
{% endblock %}

{% block content %}
    {{ actionInput('jack/profile/save') }}
    {{ redirectInput(site ? 'jack/profile/' ~ site.handle : 'jack/profile') }}
    {% if site %}{{ hiddenInput('siteId', site.id) }}{% endif %}

    <div class="readable">
        {% if site %}
            <p>{{ 'These answers apply to {site} only. Anything left blank falls back to the global profile — blanking a field here does not erase it, it stops overriding it.'|t('jack', { site: site.name }) }}</p>
        {% else %}
            <p>{{ 'Everything Jack knows about you. Each of these is a fact some clause needs; fill one in here and it is right in every document, in every language, at once.'|t('jack') }}</p>
        {% endif %}

        {% set percent = (completeness * 100)|round %}
        {% set level = completeness > 0.85 ? 'good' : (completeness > 0.6 ? 'fair' : 'poor') %}
        <div class="jack-completeness">
            <div class="jack-meter jack-meter--{{ level }}"
                 role="progressbar"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="{{ percent }}"
                 aria-labelledby="jack-completeness-label">
                <div class="jack-meter-fill" style="width: {{ percent }}%;"></div>
            </div>
            <p id="jack-completeness-label" class="light smalltext">{{ '{percent}% of the facts the clause library asks for are filled in.'|t('jack', { percent: percent }) }}</p>
        </div>
    </div>

    {% for group, groupFacts in groups %}
        <div class="pane jack-group">
            <h2>{{ groupLabels[group] ?? group|title }}</h2>

            {% for key, fact in groupFacts %}
                {% set name = 'facts[' ~ key ~ ']' %}
                {% set value = values[key] ?? '' %}
                {% set placeholder = site ? (inherited[key]|default('') ?: (fact.placeholder ?? '')) : (fact.placeholder ?? '') %}

                {% if fact.type == 'bool' %}
                    {{ forms.lightswitchField({
                        label: fact.label,
                        instructions: fact.hint ?? null,
                        name: name,
                        on: value ? true : false,
                        disabled: not canEdit,
                    }) }}
                {% elseif fact.type == 'select' %}
                    {{ forms.selectField({
                        label: fact.label,
                        instructions: fact.hint ?? null,
                        name: name,
                        value: value ?: (fact.default ?? ''),
                        options: fact.options,
                        disabled: not canEdit,
                    }) }}
                {% elseif fact.type == 'textarea' %}
                    {{ forms.textareaField({
                        label: fact.label,
                        instructions: fact.hint ?? null,
                        name: name,
                        value: value,
                        placeholder: placeholder,
                        rows: 3,
                        disabled: not canEdit,
                    }) }}
                {% else %}
                    {{ forms.textField({
                        label: fact.label,
                        instructions: fact.hint ?? null,
                        name: name,
                        value: value,
                        placeholder: placeholder,
                        type: fact.type == 'email' ? 'email' : (fact.type == 'url' ? 'url' : (fact.type == 'tel' ? 'tel' : 'text')),
                        disabled: not canEdit,
                    }) }}
                {% endif %}
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}

{% css %}
.jack-completeness { margin-block: var(--m) var(--xl); }
.jack-completeness p { margin-block-start: var(--xs); }
.jack-meter { block-size: 6px; background-color: var(--gray-200); border-radius: var(--radius-sm); overflow: hidden; }
.jack-meter-fill { block-size: 100%; background-color: var(--fg-error); }
.jack-meter--fair .jack-meter-fill { background-color: var(--fg-warning); }
.jack-meter--good .jack-meter-fill { background-color: var(--fg-success); }
.jack-group { margin-block-end: var(--m); }
.jack-sidebar-heading { padding-inline: var(--s); }
{% endcss %}
