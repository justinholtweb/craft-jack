{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = document.title %}
{% set selectedSubnavItem = 'documents' %}
{% set editPath = 'jack/documents/' ~ document.id ~ '?siteId=' ~ document.siteId %}

{% set crumbs = [{ label: 'Documents'|t('jack'), url: url('jack/documents') }] %}
{% if sites|length > 1 %}
    {% set siteItems = sites|map(s => {
        label: s.name|t('site'),
        url: url('jack/documents/' ~ document.id, { siteId: s.id }),
        selected: s.id == document.siteId,
    }) %}
    {% set crumbs = crumbs|merge([{
        id: 'jack-site-crumb',
        icon: 'world',
        label: document.site.name|t('site'),
        menu: {
            label: 'Select site'|t('app'),
            items: siteItems,
        },
    }]) %}
{% endif %}

{% set fullPageForm = canManage %}
{% set saveShortcutRedirect = editPath %}
{% if canManage %}
    {% set formActions = [
        {
            label: 'Save and continue editing'|t('app'),
            redirect: editPath|hash,
            shortcut: true,
            retainScroll: true,
        },
        {
            label: 'Recompile from the saved profile'|t('jack'),
            action: 'jack/documents/compile',
        },
        {
            label: 'Delete'|t('app'),
            action: 'jack/documents/delete',
            redirect: 'jack/documents'|hash,
            confirm: 'Delete this document?'|t('jack'),
            destructive: true,
        },
    ] %}
{% endif %}

{% set missingFacts = document.getMissingFacts() %}
{% set warnings = document.getWarnings() %}
{% set isPublished = document.publishedHtml is not empty %}
{% set hasUnpublishedChanges = (document.compiledHtml ?? '')|trim != (document.publishedHtml ?? '')|trim %}

{% block actionButton %}
    <div class="flex">
        {% if isPro %}
            <a class="btn" href="{{ url('jack/documents/' ~ document.id ~ '/history', { siteId: document.siteId }) }}">{{ 'History'|t('jack') }} ({{ versionCount }})</a>
        {% endif %}
        {% if canPublish %}
            {# A standalone POST (data-form="false" builds its own form), so nothing nests inside the
               main form. It publishes the last saved text, which is why it asks first. #}
            <button type="button"
                    class="btn formsubmit"
                    data-form="false"
                    data-action="jack/documents/publish"
                    data-params="{{ { documentId: document.id, siteId: document.siteId }|json_encode }}"
                    data-confirm="{{ 'Publish the last saved version? Unsaved changes on this screen are not included.'|t('jack') }}">{{ 'Publish'|t('jack') }}</button>
        {% endif %}
        {{ parent() }}
    </div>
{% endblock %}

{% block contentNotice %}
    {% if not canManage %}
        <div class="content-notice">
            <div class="content-notice-icon" aria-hidden="true">
                <div class="cp-icon">{{ iconSvg('lock') }}</div>
            </div>
            <p>{{ 'You can read this document but not change it.'|t('jack') }}</p>
        </div>
    {% endif %}
{% endblock %}

{% block content %}
    {% if canManage %}
        {{ actionInput('jack/documents/save') }}
        {{ hiddenInput('documentId', document.id) }}
        {{ hiddenInput('siteId', document.siteId) }}
        {{ redirectInput('jack/documents') }}
    {% endif %}

    {% if not isPublished %}
        <div class="readable">
            <blockquote class="note warning">
                <p><strong>{{ 'Not published yet.'|t('jack') }}</strong> {{ 'Visitors see nothing until a version is published.'|t('jack') }}</p>
            </blockquote>
        </div>
    {% elseif hasUnpublishedChanges %}
        <div class="readable">
            <blockquote class="note">
                <p>{{ 'This draft has changes that aren’t on the site yet. Publish to put them live.'|t('jack') }}</p>
            </blockquote>
        </div>
    {% endif %}

    {% if missingFacts|length %}
        <div class="readable">
            <blockquote class="note warning">
                <p><strong>{{ 'This document is incomplete.'|t('jack') }}</strong></p>
                <p>{{ 'Clauses in it need facts the profile does not have. Until they are filled in, the document is published with gaps where those details belong.'|t('jack') }}</p>
                <ul>
                    {% for key in missingFacts %}
                        <li>{{ facts[key].label ?? key }} <code class="light">{{ key }}</code></li>
                    {% endfor %}
                </ul>
                <p><a class="go" href="{{ url('jack/profile') }}">{{ 'Fill these in'|t('jack') }}</a></p>
            </blockquote>
        </div>
    {% endif %}

    {% if isStale %}
        <div class="readable">
            <blockquote class="note warning">
                <p><strong>{{ 'Out of date.'|t('jack') }}</strong> {{ 'What this document says and what it would say if compiled now have parted company.'|t('jack') }}</p>
                {% if canOverride %}
                    <ul>
                        {% for key in drift.changed %}
                            <li>{{ 'Changed'|t('jack') }}: <code>{{ key }}</code>{% if library.clause(key) %} ({{ library.clause(key).heading(document.languageForSite()) }}){% endif %}</li>
                        {% endfor %}
                        {% for key in drift.added %}
                            <li>{{ 'New'|t('jack') }}: <code>{{ key }}</code>{% if library.clause(key) %} ({{ library.clause(key).heading(document.languageForSite()) }}){% endif %}</li>
                        {% endfor %}
                        {% for key in drift.removed %}
                            <li>{{ 'No longer applies'|t('jack') }}: <code>{{ key }}</code></li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="light">{{ 'Jack Pro shows exactly which paragraphs moved and lets you compare them side by side.'|t('jack') }}</p>
                {% endif %}
                {% if canManage %}
                    <p>
                        <button type="button"
                                class="btn formsubmit"
                                data-action="jack/documents/compile"
                                data-param="documentId"
                                data-value="{{ document.id }}">{{ 'Recompile now'|t('jack') }}</button>
                    </p>
                {% endif %}
            </blockquote>
        </div>
    {% endif %}

    {% for warning in warnings %}
        <div class="readable"><blockquote class="note"><p>{{ warning }}</p></blockquote></div>
    {% endfor %}

    <div id="fields">
        {{ forms.textField({
            label: 'Title'|t('app'),
            id: 'title',
            name: 'title',
            value: document.title,
            required: true,
            disabled: not canManage,
            errors: document.getErrors('title'),
        }) }}

        {{ forms.textField({
            label: 'Slug'|t('app'),
            id: 'slug',
            name: 'slug',
            value: document.slug,
            disabled: not canManage,
            errors: document.getErrors('slug'),
        }) }}

        <hr>

        <h2>{{ 'Draft preview'|t('jack') }}</h2>
        <p class="light">{{ 'What this document will say once it is published. The live page shows the last published version.'|t('jack') }}</p>

        {% for section in compiled.sections %}
            {% set override = overrides[section.clauseKey] ?? {} %}
            {% set overrideId = 'override-' ~ loop.index %}
            {% set isOverridden = section.isOverridden() %}

            <section class="pane jack-section">
                <div class="flex flex-nowrap jack-section-header">
                    <h3>{{ section.heading }}</h3>
                    <div class="light smalltext">
                        <code>{{ section.clauseKey }}</code>
                        {% if section.citation %} · {{ section.citation }}{% endif %}
                        {% if isOverridden %} · <strong>{{ 'edited'|t('jack') }}</strong>{% endif %}
                    </div>
                </div>

                {% if section.note %}
                    <p class="light smalltext">{{ section.note }}</p>
                {% endif %}

                {% if section.missingFacts|length %}
                    <p class="error smalltext">{{ 'Needs:'|t('jack') }}
                        {% for key in section.missingFacts %}<code>{{ key }}</code>{{ not loop.last ? ', ' }}{% endfor %}
                    </p>
                {% endif %}

                <div class="jack-preview readable">{{ section.html|raw }}</div>

                {% if canManage and canOverride %}
                    <div class="jack-override">
                        <button type="button"
                                class="btn small fieldtoggle"
                                data-target="{{ overrideId }}"
                                aria-expanded="{{ isOverridden ? 'true' : 'false' }}">{{ 'Rewrite this section'|t('jack') }}</button>
                        <div id="{{ overrideId }}" class="jack-override-fields{{ isOverridden ? '' : ' hidden' }}">
                            {{ forms.textField({
                                label: 'Heading'|t('jack'),
                                name: 'overrides[' ~ section.clauseKey ~ '][heading]',
                                value: override.heading ?? '',
                                placeholder: section.heading,
                            }) }}
                            {{ forms.textareaField({
                                label: 'Text'|t('jack'),
                                instructions: 'HTML. Leave empty to keep the library’s wording — and to keep receiving updates to it, which an edited section stops getting.'|t('jack'),
                                name: 'overrides[' ~ section.clauseKey ~ '][body]',
                                value: override.body ?? '',
                                rows: 8,
                                class: 'code',
                            }) }}
                            {{ forms.checkboxField({
                                label: 'Leave this section out'|t('jack'),
                                name: 'overrides[' ~ section.clauseKey ~ '][disabled]',
                                checked: override.disabled ?? false,
                            }) }}
                        </div>
                    </div>
                {% endif %}
            </section>
        {% else %}
            <div class="zilch small">
                <p>{{ 'Nothing to show yet — no clause in the library applies to this document with the facts Jack has.'|t('jack') }}</p>
            </div>
        {% endfor %}

        {% if canManage and canOverride %}
            <section class="pane jack-section">
                <h3>{{ 'Add a section'|t('jack') }}</h3>
                <p class="light smalltext">{{ 'For something the library has no clause for. It is yours to maintain — Jack will never update it.'|t('jack') }}</p>
                {{ forms.textField({
                    label: 'Heading'|t('jack'),
                    name: 'overrides[custom:1][heading]',
                    value: overrides['custom:1'].heading ?? '',
                }) }}
                {{ forms.textareaField({
                    label: 'Text'|t('jack'),
                    name: 'overrides[custom:1][body]',
                    value: overrides['custom:1'].body ?? '',
                    rows: 6,
                    class: 'code',
                }) }}
            </section>
        {% endif %}
    </div>
{% endblock %}

{% block details %}
    <div class="meta">
        {{ forms.lightswitchField({
            label: 'Enabled'|t('app'),
            id: 'enabled',
            name: 'enabled',
            on: document.enabled,
            disabled: not canManage,
            errors: document.getErrors('enabled'),
        }) }}

        {{ forms.selectField({
            label: 'Jurisdiction'|t('jack'),
            instructions: 'Which country’s clauses this document is written for.'|t('jack'),
            id: 'jurisdiction',
            name: 'jurisdiction',
            value: document.jurisdiction,
            disabled: not canManage,
            errors: document.getErrors('jurisdiction'),
            options: [
                { label: 'Germany'|t('jack'), value: 'de' },
                { label: 'Austria'|t('jack'), value: 'at' },
                { label: 'Switzerland'|t('jack'), value: 'ch' },
                { label: 'European Union'|t('jack'), value: 'eu' },
                { label: 'United Kingdom'|t('jack'), value: 'uk' },
                { label: 'United States'|t('jack'), value: 'us' },
            ],
        }) }}
    </div>

    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">{{ 'Live version'|t('jack') }}</dt>
            <dd class="value">
                {% if isPublished %}
                    {{ 'Published {date}'|t('jack', { date: document.publishedAt ? document.publishedAt|datetime('short') : '' }) }}
                {% else %}
                    {{ 'Not published. Visitors see nothing yet.'|t('jack') }}
                {% endif %}
            </dd>
        </div>
        {% if isPublished %}
            <div class="data">
                <dt class="heading">{{ 'Draft'|t('jack') }}</dt>
                <dd class="value">{{ hasUnpublishedChanges ? 'Has unpublished changes'|t('jack') : 'Same as the live version'|t('jack') }}</dd>
            </div>
        {% endif %}
        <div class="data">
            <dt class="heading">{{ 'Type'|t('jack') }}</dt>
            <dd class="value">{{ document.typeLabel() }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Language'|t('jack') }}</dt>
            <dd class="value">{{ document.languageForSite() }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'Compiled'|t('jack') }}</dt>
            <dd class="value">{{ document.compiledAt ? document.compiledAt|datetime('short') : 'never'|t('jack') }}</dd>
        </div>
        {% if document.url %}
            <div class="data">
                <dt class="heading">{{ 'URL'|t('app') }}</dt>
                <dd class="value"><a href="{{ document.url }}" rel="noopener" target="_blank">{{ document.uri }}</a></dd>
            </div>
        {% endif %}
    </dl>
{% endblock %}

{% css %}
.jack-section { margin-block-end: var(--m); }
.jack-section-header { justify-content: space-between; align-items: baseline; gap: var(--s); }
.jack-section-header h3 { margin: 0; }
.jack-section .jack-preview { margin-block-start: var(--s); }
.jack-override { margin-block-start: var(--s); }
.jack-override-fields { margin-block-start: var(--s); }
{% endcss %}
