{% extends '_layouts/cp' %}

{% set title = 'History'|t('jack') ~ ' — ' ~ document.title %}
{% set selectedSubnavItem = 'documents' %}
{% set crumbs = [
    { label: 'Documents'|t('jack'), url: url('jack/documents') },
    { label: document.title, url: url('jack/documents/' ~ document.id, { siteId: document.siteId }) },
] %}

{% block content %}
    <div class="readable">
        <p>{{ 'Every published version of this document, kept forever. The question these answer is “what did our privacy policy say on the day this customer signed up”, and nothing about the current state answers it.'|t('jack') }}</p>
    </div>

    {% if versions|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Published'|t('jack') }}</th>
                    <th scope="col">{{ 'Note'|t('jack') }}</th>
                    <th scope="col">{{ 'Library'|t('jack') }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'Actions'|t('app') }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for version in versions %}
                    <tr>
                        <td>{{ version.created|datetime('short') }}{% if loop.first %} <span class="light">({{ 'latest'|t('jack') }})</span>{% endif %}</td>
                        <td>{% if version.note %}{{ version.note }}{% else %}<span class="light">{{ 'No note'|t('jack') }}</span>{% endif %}</td>
                        <td class="light">{{ version.libraryVersion ?: '' }}</td>
                        <td class="thin">
                            {% if not loop.first %}
                                <a class="btn small" href="{{ url('jack/documents/' ~ document.id ~ '/compare', {
                                    siteId: document.siteId,
                                    from: version.id,
                                    to: versions[0].id,
                                }) }}">{{ 'Compare with latest'|t('jack') }}</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="zilch">
            <p>{{ 'Nothing published yet. Publishing freezes what the document currently says into a version somebody can be pointed at later.'|t('jack') }}</p>
        </div>
    {% endif %}
{% endblock %}
