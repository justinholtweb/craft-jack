{% extends '_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set title = 'New legal document'|t('jack') %}
{% set selectedSubnavItem = 'documents' %}
{% set crumbs = [{ label: 'Documents'|t('jack'), url: url('jack/documents') }] %}

{% set typeOptions = [] %}
{% set firstAllowed = null %}
{% for type, label in typeLabels %}
    {% set allowed = type in availableTypes %}
    {% set exists = type not in missingTypes %}
    {% if allowed and firstAllowed is null %}
        {% set firstAllowed = type %}
    {% endif %}
    {% set suffix = not allowed ? 'Pro'|t('jack') : (exists ? 'you already have one'|t('jack') : null) %}
    {% set typeOptions = typeOptions|merge([{
        label: suffix ? label ~ ' (' ~ suffix ~ ')' : label,
        value: type,
        disabled: not allowed,
    }]) %}
{% endfor %}

{% block content %}
    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('jack/documents/new') }}

        <div class="readable">
            <p>{{ 'Pick what you need. Jack writes it from the profile and the inventory — you are choosing a document, not a blank page.'|t('jack') }}</p>
        </div>

        {{ forms.radioGroupField({
            label: 'Document type'|t('jack'),
            id: 'documentType',
            name: 'documentType',
            options: typeOptions,
            value: firstAllowed,
        }) }}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ 'Create'|t('jack') }}</button>
        </div>
    </form>
{% endblock %}
