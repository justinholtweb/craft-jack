{
    "name": "justinholtweb/craft-jack",
    "description": "Legal texts for Craft CMS — imprint, privacy policy, cookies and terms, generated from the facts about your site and kept current as the law moves.",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "jack",
        "legal",
        "privacy policy",
        "imprint",
        "impressum",
        "datenschutzerklärung",
        "gdpr",
        "dsgvo",
        "ccpa",
        "cookies",
        "compliance"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://craft-jack.com/docs",
        "source": "https://github.com/justinholtweb/craft-jack",
        "issues": "https://github.com/justinholtweb/craft-jack/issues",
        "email": "justin@justinholt.com"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\jack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\jack\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Jack",
        "handle": "jack",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://craft-jack.com/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-jack/main/CHANGELOG.md",
        "class": "justinholtweb\\jack\\Plugin"
    }
}
